#!/usr/bin/env python3
"""CampusMind — Smart Campus Management System.
Pure Python stdlib + SQLite. No frameworks.
"""
import hashlib
import hmac
import json
import os
import re
import secrets
import sqlite3
import time
from datetime import date, datetime, timedelta, timezone
from http.server import HTTPServer, BaseHTTPRequestHandler
from urllib.parse import parse_qs, urlparse

# ─────────────────────────────────────────────
# Config
# ─────────────────────────────────────────────
PORT = 8080
DB_PATH = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'campusmind.db')
SECRET_KEY = os.environ.get('SECRET_KEY', secrets.token_hex(32))
SESSION_NAME = 'campusmind_session'
SESSION_MAX_AGE = 86400 * 7  # 7 days

# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
def get_db() -> sqlite3.Connection:
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA journal_mode=WAL")
    conn.execute("PRAGMA foreign_keys=ON")
    return conn


def init_db():
    conn = get_db()
    conn.executescript("""
    CREATE TABLE IF NOT EXISTS users (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        name TEXT NOT NULL,
        email TEXT UNIQUE NOT NULL,
        password_hash TEXT NOT NULL,
        role TEXT NOT NULL DEFAULT 'student',
        student_id TEXT,
        department TEXT,
        created_at TEXT DEFAULT (datetime('now'))
    );

    CREATE TABLE IF NOT EXISTS courses (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        code TEXT UNIQUE NOT NULL,
        name TEXT NOT NULL,
        credits INTEGER DEFAULT 3,
        department TEXT,
        teacher_id INTEGER REFERENCES users(id),
        semester TEXT,
        created_at TEXT DEFAULT (datetime('now'))
    );

    CREATE TABLE IF NOT EXISTS enrollments (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        student_id INTEGER NOT NULL REFERENCES users(id),
        course_id INTEGER NOT NULL REFERENCES courses(id),
        enrolled_at TEXT DEFAULT (datetime('now')),
        UNIQUE(student_id, course_id)
    );

    CREATE TABLE IF NOT EXISTS routines (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        course_id INTEGER NOT NULL REFERENCES courses(id),
        day_of_week TEXT NOT NULL,
        start_time TEXT NOT NULL,
        end_time TEXT NOT NULL,
        room TEXT NOT NULL
    );

    CREATE TABLE IF NOT EXISTS attendance_sessions (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        course_id INTEGER NOT NULL REFERENCES courses(id),
        teacher_id INTEGER NOT NULL REFERENCES users(id),
        qr_code TEXT NOT NULL,
        session_date TEXT DEFAULT (date('now')),
        expires_at TEXT NOT NULL,
        is_active INTEGER DEFAULT 1,
        created_at TEXT DEFAULT (datetime('now'))
    );

    CREATE TABLE IF NOT EXISTS attendance_records (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        session_id INTEGER NOT NULL REFERENCES attendance_sessions(id),
        student_id INTEGER NOT NULL REFERENCES users(id),
        method TEXT NOT NULL DEFAULT 'qr',
        status TEXT NOT NULL DEFAULT 'present',
        marked_at TEXT DEFAULT (datetime('now')),
        UNIQUE(session_id, student_id)
    );

    CREATE TABLE IF NOT EXISTS results (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        student_id INTEGER NOT NULL REFERENCES users(id),
        course_id INTEGER NOT NULL REFERENCES courses(id),
        exam_type TEXT NOT NULL,
        marks_obtained REAL NOT NULL,
        total_marks REAL NOT NULL,
        grade TEXT,
        grade_point REAL,
        created_at TEXT DEFAULT (datetime('now'))
    );

    CREATE TABLE IF NOT EXISTS syllabus_topics (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        course_id INTEGER NOT NULL REFERENCES courses(id),
        title TEXT NOT NULL,
        week_number INTEGER,
        is_completed INTEGER DEFAULT 0
    );

    CREATE TABLE IF NOT EXISTS notifications (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        user_id INTEGER NOT NULL REFERENCES users(id),
        title TEXT NOT NULL,
        message TEXT NOT NULL,
        is_read INTEGER DEFAULT 0,
        created_at TEXT DEFAULT (datetime('now'))
    );
    """)
    conn.commit()
    conn.close()


# ─────────────────────────────────────────────
# Auth Helpers
# ─────────────────────────────────────────────
def hash_password(password: str) -> str:
    salt = secrets.token_hex(16)
    h = hashlib.pbkdf2_hmac('sha256', password.encode(), salt.encode(), 100000)
    return f"{salt}${h.hex()}"


def verify_password(password: str, stored: str) -> bool:
    salt, h = stored.split('$', 1)
    check = hashlib.pbkdf2_hmac('sha256', password.encode(), salt.encode(), 100000)
    return hmac.compare_digest(check.hex(), h)


def create_session_token(user_id: int) -> str:
    payload = f"{user_id}:{int(time.time())}"
    sig = hmac.new(SECRET_KEY.encode(), payload.encode(), hashlib.sha256).hexdigest()
    return f"{payload}:{sig}"


def verify_session_token(token: str) -> int | None:
    try:
        parts = token.split(':')
        if len(parts) != 3:
            return None
        uid, ts, sig = parts
        payload = f"{uid}:{ts}"
        expected = hmac.new(SECRET_KEY.encode(), payload.encode(), hashlib.sha256).hexdigest()
        if not hmac.compare_digest(sig, expected):
            return None
        if int(time.time()) - int(ts) > SESSION_MAX_AGE:
            return None
        return int(uid)
    except (ValueError, TypeError):
        return None


def get_current_user(handler) -> dict | None:
    cookies = parse_cookies(handler.headers.get('Cookie', ''))
    token = cookies.get(SESSION_NAME)
    if not token:
        return None
    uid = verify_session_token(token)
    if uid is None:
        return None
    conn = get_db()
    row = conn.execute("SELECT id, name, email, role, student_id, department FROM users WHERE id=?", (uid,)).fetchone()
    conn.close()
    return dict(row) if row else None


def parse_cookies(cookie_str: str) -> dict:
    cookies = {}
    for item in cookie_str.split(';'):
        if '=' in item:
            k, v = item.strip().split('=', 1)
            cookies[k] = v
    return cookies


# ─────────────────────────────────────────────
# Grade Calculator
# ─────────────────────────────────────────────
def calc_grade(marks: float, total: float) -> tuple[str, float]:
    pct = (marks / total) * 100 if total > 0 else 0
    if pct >= 80: return 'A+', 4.00
    if pct >= 75: return 'A', 3.75
    if pct >= 70: return 'A-', 3.50
    if pct >= 65: return 'B+', 3.25
    if pct >= 60: return 'B', 3.00
    if pct >= 55: return 'B-', 2.75
    if pct >= 50: return 'C+', 2.50
    if pct >= 45: return 'C', 2.25
    if pct >= 40: return 'D', 2.00
    return 'F', 0.00


# ─────────────────────────────────────────────
# Assistant Logic
# ─────────────────────────────────────────────
DAY_MAP = {
    'saturday': 'Saturday', 'sunday': 'Sunday', 'monday': 'Monday',
    'tuesday': 'Tuesday', 'wednesday': 'Wednesday', 'thursday': 'Thursday',
    'friday': 'Friday',
}


def detect_query_type(msg: str) -> str:
    msg = msg.lower().strip()
    if re.search(r'[a-z]{2,4}-\d{3}', msg):
        if any(kw in msg for kw in ['teacher', 'কে', 'শিক্ষক', 'স্যার']):
            return 'course_teacher'
    if any(kw in msg for kw in ['attendance', 'উপস্থিতি', 'হাজিরা', 'এটেন্ডেন্স']):
        return 'attendance_stats'
    if any(kw in msg for kw in ['tomorrow', 'কাল', 'আগামীকাল']):
        if any(kw in msg for kw in ['class', 'ক্লাস']):
            return 'tomorrow_class'
    if any(kw in msg for kw in ['today', 'আজ', 'আজকে']):
        if any(kw in msg for kw in ['class', 'ক্লাস']):
            return 'today_class'
    if any(kw in msg for kw in ['next', 'পরবর্তী', 'নেক্সট']):
        if any(kw in msg for kw in ['class', 'ক্লাস']):
            return 'next_class'
    if any(kw in msg for kw in ['cgpa', 'সিজিপিএ', 'জিপিএ']):
        return 'cgpa'
    if any(kw in msg for kw in ['result', 'রেজাল্ট', 'ফলাফল']):
        return 'results'
    return 'unknown'


def assistant_reply(user_id: int, message: str) -> str:
    qtype = detect_query_type(message)
    conn = get_db()
    reply = ""

    if qtype == 'tomorrow_class':
        tomorrow = (date.today() + timedelta(days=1)).strftime('%A')
        rows = conn.execute("""
            SELECT r.start_time, r.room, c.code, c.name
            FROM routines r JOIN courses c ON r.course_id = c.id
            JOIN enrollments e ON e.course_id = c.id
            WHERE e.student_id=? AND r.day_of_week=?
            ORDER BY r.start_time
        """, (user_id, tomorrow)).fetchall()
        if rows:
            items = [f"{r['code']} ({r['name']}) at {r['start_time']} in Room {r['room']}" for r in rows]
            reply = f"Tomorrow ({tomorrow}) you have: {'; '.join(items)}"
        else:
            reply = f"No classes scheduled for tomorrow ({tomorrow}). 🎉"

    elif qtype == 'today_class':
        today = date.today().strftime('%A')
        rows = conn.execute("""
            SELECT r.start_time, r.room, c.code, c.name
            FROM routines r JOIN courses c ON r.course_id = c.id
            JOIN enrollments e ON e.course_id = c.id
            WHERE e.student_id=? AND r.day_of_week=?
            ORDER BY r.start_time
        """, (user_id, today)).fetchall()
        if rows:
            items = [f"{r['code']} at {r['start_time']} in Room {r['room']}" for r in rows]
            reply = f"Today's classes: {'; '.join(items)}"
        else:
            reply = "No classes today. Enjoy! 🎉"

    elif qtype == 'next_class':
        today = date.today().strftime('%A')
        now = datetime.now().strftime('%H:%M')
        row = conn.execute("""
            SELECT r.start_time, r.room, c.code
            FROM routines r JOIN courses c ON r.course_id = c.id
            JOIN enrollments e ON e.course_id = c.id
            WHERE e.student_id=? AND r.day_of_week=? AND r.start_time > ?
            ORDER BY r.start_time LIMIT 1
        """, (user_id, today, now)).fetchone()
        if row:
            reply = f"Next class: {row['code']} at {row['start_time']} in Room {row['room']}"
        else:
            reply = "No more classes today. You're free! 🎉"

    elif qtype == 'attendance_stats':
        enrollments = conn.execute("SELECT course_id FROM enrollments WHERE student_id=?", (user_id,)).fetchall()
        if not enrollments:
            reply = "You are not enrolled in any courses yet."
        else:
            details = []
            total_present, total_sessions = 0, 0
            for enr in enrollments:
                cid = enr['course_id']
                ts = conn.execute("SELECT COUNT(*) as c FROM attendance_sessions WHERE course_id=?", (cid,)).fetchone()['c']
                pc = conn.execute("""
                    SELECT COUNT(*) as c FROM attendance_records ar
                    JOIN attendance_sessions s ON ar.session_id = s.id
                    WHERE ar.student_id=? AND s.course_id=? AND ar.status='present'
                """, (user_id, cid)).fetchone()['c']
                total_present += pc
                total_sessions += ts
                course = conn.execute("SELECT code FROM courses WHERE id=?", (cid,)).fetchone()
                pct = round(pc / ts * 100, 1) if ts > 0 else 0
                details.append(f"{course['code']}: {pct}%")
            overall = round(total_present / total_sessions * 100, 1) if total_sessions > 0 else 0
            reply = f"Your overall attendance is {overall}%. Breakdown: {'; '.join(details)}"

    elif qtype == 'course_teacher':
        match = re.search(r'([a-z]{2,4}-\d{3})', message.lower())
        if match:
            code = match.group(1).upper()
            row = conn.execute("""
                SELECT c.code, c.name, u.name as teacher_name
                FROM courses c LEFT JOIN users u ON c.teacher_id = u.id
                WHERE UPPER(c.code) LIKE ?
            """, (f'%{code}%',)).fetchone()
            if row:
                reply = f"{row['code']} ({row['name']}) is taught by {row['teacher_name'] or 'TBA'}."
            else:
                reply = f"Course {code} not found."
        else:
            reply = "Please specify a course code like CSE-301."

    elif qtype == 'cgpa':
        rows = conn.execute("SELECT grade_point FROM results WHERE student_id=?", (user_id,)).fetchall()
        if not rows:
            reply = "No results available yet to calculate CGPA."
        else:
            total_gp = sum(r['grade_point'] or 0 for r in rows)
            cgpa = round(total_gp / len(rows), 2)
            reply = f"Your current CGPA is {cgpa} based on {len(rows)} results."

    elif qtype == 'results':
        rows = conn.execute("""
            SELECT c.code, r.grade, r.marks_obtained, r.total_marks
            FROM results r JOIN courses c ON r.course_id = c.id
            WHERE r.student_id=? ORDER BY r.created_at DESC LIMIT 5
        """, (user_id,)).fetchall()
        if rows:
            items = [f"{r['code']}: {r['grade']} ({r['marks_obtained']}/{r['total_marks']})" for r in rows]
            reply = f"Your recent results: {'; '.join(items)}"
        else:
            reply = "No results published yet."

    else:
        reply = ("I can help with:\n"
                 "• 'amar kal ki class?' — Tomorrow's classes\n"
                 "• 'amar attendance koto?' — Attendance stats\n"
                 "• 'CSE-301 er teacher ke?' — Course teacher\n"
                 "• 'amar cgpa koto?' — Your CGPA\n"
                 "• 'amar result dekhao' — Recent results\n\n"
                 "Try asking in Bangla or English! 😊")

    conn.close()
    return reply


# ─────────────────────────────────────────────
# HTML Templates
# ─────────────────────────────────────────────
def layout(title: str, body: str, user: dict | None = None) -> str:
    nav_links = ""
    if user:
        role = user['role']
        nav_links = f"""
        <a href="/dashboard">Dashboard</a>
        <a href="/courses">Courses</a>
        <a href="/routine">Routine</a>
        <a href="/attendance">Attendance</a>
        <a href="/results">Results</a>
        <a href="/assistant">Assistant</a>
        <a href="/notifications">Notifications</a>
        """
        if role in ('teacher', 'admin'):
            nav_links += '<a href="/teacher">Teacher Panel</a>'

    notif_badge = ""
    if user:
        conn = get_db()
        unread = conn.execute("SELECT COUNT(*) as c FROM notifications WHERE user_id=? AND is_read=0", (user['id'],)).fetchone()['c']
        conn.close()
        if unread > 0:
            notif_badge = f'<span class="badge badge-red" id="notifBadge">{unread}</span>'

    user_section = ""
    if user:
        user_section = f"""
        <div class="nav-user">
            <span>{user['name']}</span>
            <span class="badge badge-blue">{user['role']}</span>
            {notif_badge}
            <a href="/logout" class="btn btn-sm btn-secondary">Logout</a>
        </div>"""
    else:
        user_section = '<div class="nav-user"><a href="/login" class="btn btn-sm btn-primary">Login</a></div>'

    return f"""<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title} — CampusMind</title>
    <link rel="stylesheet" href="/static/style.css">
</head>
<body>
    <nav class="nav">
        <a href="/" class="nav-brand">🎓 CampusMind</a>
        <div class="nav-links">{nav_links}</div>
        {user_section}
    </nav>
    <div class="container">
        {body}
    </div>
    <script src="/static/app.js"></script>
</body>
</html>"""


def page_login(error: str = "") -> str:
    alert = f'<div class="alert alert-error">{error}</div>' if error else ""
    return layout("Login", f"""
    <div class="auth-wrap">
        <div class="auth-card">
            <h1>Welcome back</h1>
            <p class="subtitle">Sign in to CampusMind</p>
            {alert}
            <form method="POST" action="/login">
                <div class="form-group">
                    <label>Email</label>
                    <input type="email" name="email" required placeholder="you@university.edu">
                </div>
                <div class="form-group">
                    <label>Password</label>
                    <input type="password" name="password" required placeholder="••••••••">
                </div>
                <button type="submit" class="btn btn-primary btn-block">Sign In</button>
            </form>
            <p class="text-sm text-muted mt-16 text-center">Don't have an account? <a href="/register">Register</a></p>
        </div>
    </div>""")


