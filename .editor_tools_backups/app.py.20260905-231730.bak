                <input id="chatInput" placeholder="Ask me anything..." autocomplete="off">
                <button id="chatSend" class="btn btn-primary">Send</button>
            </div>
        </div>
    </div>
    """, user)


# ─────────────────────────────────────────────
# HTTP Handler
# ─────────────────────────────────────────────
class Handler(BaseHTTPRequestHandler):

    def send_html(self, html: str, status: int = 200):
        self.send_response(status)
        self.send_header('Content-Type', 'text/html; charset=utf-8')
        self.end_headers()
        self.wfile.write(html.encode())

    def send_json(self, data: dict, status: int = 200):
        self.send_response(status)
        self.send_header('Content-Type', 'application/json')
        self.end_headers()
        self.wfile.write(json.dumps(data).encode())

    def send_redirect(self, path: str):
        self.send_response(302)
        self.send_header('Location', path)
        self.end_headers()

    def read_body(self) -> dict:
        length = int(self.headers.get('Content-Length', 0))
        if length == 0:
            return {}
        raw = self.rfile.read(length).decode()
        ct = self.headers.get('Content-Type', '')
        if 'application/json' in ct:
            return json.loads(raw)
        return {k: v[0] for k, v in parse_qs(raw).items()}

    def get_user(self) -> dict | None:
        return get_current_user(self)

    def require_auth(self) -> dict | None:
        user = self.get_user()
        if not user:
            self.send_redirect('/login')
            return None
        return user

    # ── Routing ──
    def do_GET(self):
        path = urlparse(self.path).path

        # Static files
        if path.startswith('/static/'):
            self.serve_static(path)
            return

        # Public pages
        if path == '/login':
            self.send_html(page_login())
            return
        if path == '/register':
            self.send_html(page_register())
            return
        if path == '/logout':
            self.send_response(302)
            self.send_header('Set-Cookie', f'{SESSION_NAME}=; Max-Age=0; Path=/')
            self.send_header('Location', '/login')
            self.end_headers()
            return

        # Protected pages
        user = self.require_auth()
        if not user:
            return

        routes = {
            '/': '/dashboard',
            '/dashboard': lambda: page_dashboard(user),
            '/courses': lambda: page_courses(user),
            '/routine': lambda: page_routine(user),
            '/attendance': lambda: page_attendance(user),
            '/results': lambda: page_results(user),
            '/notifications': lambda: page_notifications(user),
            '/assistant': lambda: page_assistant(user),
            '/teacher': lambda: page_teacher(user) if user['role'] in ('teacher', 'admin') else page_dashboard(user),
        }

        if path in routes:
            handler = routes[path]
            if callable(handler):
                self.send_html(handler())
            else:
                self.send_redirect(handler)
            return

        self.send_html(layout("404", "<div class='empty-state'><div class='icon'>404</div><p>Page not found</p></div>", user), 404)

    def do_POST(self):
        path = urlparse(self.path).path
        body = self.read_body()

        # ── API Routes ──
        if path.startswith('/api/'):
            self.handle_api(path, body)
            return

        # ── Form POST Routes ──
        if path == '/login':
            self.handle_login(body)
        elif path == '/register':
            self.handle_register(body)
        elif path == '/courses/create':
            self.handle_course_create(body)
        elif path == '/courses/enroll':
            self.handle_enroll(body)
        elif path == '/routine/create':
            self.handle_routine_create(body)
        elif path == '/teacher/result':
            self.handle_result_submit(body)
        elif path == '/teacher/syllabus':
            self.handle_syllabus_create(body)
        else:
            self.send_redirect('/')

    # ── Auth Handlers ──
    def handle_login(self, body: dict):
        email = body.get('email', '').strip()
        password = body.get('password', '')
        conn = get_db()
        row = conn.execute("SELECT * FROM users WHERE email=?", (email,)).fetchone()
        conn.close()

        if not row or not verify_password(password, row['password_hash']):
            self.send_html(page_login("Invalid email or password"), 401)
            return

        token = create_session_token(row['id'])
        self.send_response(302)
        self.send_header('Set-Cookie', f'{SESSION_NAME}={token}; Path=/; HttpOnly; Max-Age={SESSION_MAX_AGE}')
        self.send_header('Location', '/dashboard')
        self.end_headers()

    def handle_register(self, body: dict):
        name = body.get('name', '').strip()
        email = body.get('email', '').strip()
        password = body.get('password', '')
        role = body.get('role', 'student')
        student_id = body.get('student_id', '')
        department = body.get('department', '')

        if not name or not email or not password:
            self.send_html(page_register("All fields required"), 400)
            return
        if len(password) < 6:
            self.send_html(page_register("Password must be at least 6 characters"), 400)
            return

        conn = get_db()
        existing = conn.execute("SELECT id FROM users WHERE email=?", (email,)).fetchone()
        if existing:
            conn.close()
            self.send_html(page_register("Email already registered"), 400)
            return

        conn.execute("INSERT INTO users (name, email, password_hash, role, student_id, department) VALUES (?,?,?,?,?,?)",
                     (name, email, hash_password(password), role, student_id, department))
        conn.commit()
        uid = conn.execute("SELECT id FROM users WHERE email=?", (email,)).fetchone()['id']
        conn.close()

        token = create_session_token(uid)
        self.send_response(302)
        self.send_header('Set-Cookie', f'{SESSION_NAME}={token}; Path=/; HttpOnly; Max-Age={SESSION_MAX_AGE}')
        self.send_header('Location', '/dashboard')
        self.end_headers()

    # ── Course Handlers ──
    def handle_course_create(self, body: dict):
        user = self.get_user()
        if not user or user['role'] not in ('teacher', 'admin'):
            self.send_redirect('/login')
            return
        conn = get_db()
        try:
            conn.execute("INSERT INTO courses (code, name, credits, department, semester, teacher_id) VALUES (?,?,?,?,?,?)",
                         (body.get('code'), body.get('name'), int(body.get('credits', 3)),
                          body.get('department'), body.get('semester'), user['id']))
            conn.commit()
        except sqlite3.IntegrityError:
            pass
        conn.close()
        self.send_redirect('/courses')

    def handle_enroll(self, body: dict):
        user = self.get_user()
        if not user:
            self.send_redirect('/login')
            return
        conn = get_db()
        try:
            conn.execute("INSERT INTO enrollments (student_id, course_id) VALUES (?,?)",
                         (user['id'], int(body.get('course_id', 0))))
            conn.commit()
        except sqlite3.IntegrityError:
            pass
        conn.close()
        self.send_redirect('/courses')

    # ── Routine Handler ──
    def handle_routine_create(self, body: dict):
        user = self.get_user()
        if not user or user['role'] not in ('teacher', 'admin'):
            self.send_redirect('/login')
            return
        conn = get_db()
        conn.execute("INSERT INTO routines (course_id, day_of_week, start_time, end_time, room) VALUES (?,?,?,?,?)",
                     (int(body.get('course_id', 0)), body.get('day_of_week'),
                      body.get('start_time'), body.get('end_time'), body.get('room')))
        conn.commit()
        conn.close()
        self.send_redirect('/routine')

    # ── Result Handler ──
    def handle_result_submit(self, body: dict):
        user = self.get_user()
        if not user or user['role'] not in ('teacher', 'admin'):
            self.send_redirect('/login')
            return
        marks = float(body.get('marks', 0))
        total = float(body.get('total', 100))
        grade, gp = calc_grade(marks, total)
        conn = get_db()
        conn.execute("INSERT INTO results (student_id, course_id, exam_type, marks_obtained, total_marks, grade, grade_point) VALUES (?,?,?,?,?,?,?)",
                     (int(body.get('student_id', 0)), int(body.get('course_id', 0)),
                      body.get('exam_type'), marks, total, grade, gp))
        conn.commit()
        conn.close()
        self.send_redirect('/teacher')

    # ── Syllabus Handler ──
    def handle_syllabus_create(self, body: dict):
        user = self.get_user()
        if not user or user['role'] not in ('teacher', 'admin'):
            self.send_redirect('/login')
            return
        conn = get_db()
        conn.execute("INSERT INTO syllabus_topics (course_id, title, week_number) VALUES (?,?,?)",
                     (int(body.get('course_id', 0)), body.get('title'), int(body.get('week_number', 0)) or None))
        conn.commit()
        conn.close()
        self.send_redirect('/teacher')

    # ── API Handlers ──
    def handle_api(self, path: str, body: dict):
        user = self.get_user()
        if not user:
            self.send_json({"error": "Unauthorized"}, 401)
            return

        if path == '/api/assistant/chat':
            reply = assistant_reply(user['id'], body.get('message', ''))
            self.send_json({"reply": reply})

        elif path == '/api/attendance/mark':
            self.api_mark_attendance(user, body)

        elif path == '/api/attendance/session':
            self.api_create_session(user, body)

        elif path.startswith('/api/notifications/') and path.endswith('/read'):
            nid = path.split('/')[3]
            conn = get_db()
            conn.execute("UPDATE notifications SET is_read=1 WHERE id=? AND user_id=?", (nid, user['id']))
            conn.commit()
            conn.close()
            self.send_json({"ok": True})

        elif path.startswith('/api/syllabus/') and path.endswith('/toggle'):
            tid = path.split('/')[3]
            conn = get_db()
            conn.execute("UPDATE syllabus_topics SET is_completed = 1 - is_completed WHERE id=?", (tid,))
            conn.commit()
            conn.close()
            self.send_json({"ok": True})

        else:
            self.send_json({"error": "Not found"}, 404)

    def api_mark_attendance(self, user: dict, body: dict):
        session_id = body.get('session_id')
        qr_code = body.get('qr_code', '')
        conn = get_db()

        session = conn.execute("SELECT * FROM attendance_sessions WHERE id=? AND is_active=1", (session_id,)).fetchone()
        if not session:
            conn.close()
            self.send_json({"error": "Invalid or expired session"}, 400)
            return
        if session['qr_code'] != qr_code:
            conn.close()
            self.send_json({"error": "Invalid QR code"}, 400)
            return
        if datetime.now() > datetime.fromisoformat(session['expires_at']):
            conn.close()
            self.send_json({"error": "Session expired"}, 400)
            return

        enrolled = conn.execute("SELECT id FROM enrollments WHERE student_id=? AND course_id=?",
                                (user['id'], session['course_id'])).fetchone()
        if not enrolled:
            conn.close()
            self.send_json({"error": "Not enrolled in this course"}, 403)
            return

        dup = conn.execute("SELECT id FROM attendance_records WHERE session_id=? AND student_id=?",
                           (session_id, user['id'])).fetchone()
        if dup:
            conn.close()
            self.send_json({"error": "Already marked"}, 400)
            return

        conn.execute("INSERT INTO attendance_records (session_id, student_id, method, status) VALUES (?,?,?,?)",
                     (session_id, user['id'], 'qr', 'present'))
        conn.commit()
        conn.close()
        self.send_json({"ok": True, "status": "present"})

    def api_create_session(self, user: dict, body: dict):
        if user['role'] not in ('teacher', 'admin'):
            self.send_json({"error": "Teachers only"}, 403)
            return
        course_id = body.get('course_id')
        duration = int(body.get('duration_minutes', 10))
        conn = get_db()

        course = conn.execute("SELECT id FROM courses WHERE id=? AND teacher_id=?", (course_id, user['id'])).fetchone()
        if not course:
            conn.close()
            self.send_json({"error": "You don't teach this course"}, 403)
            return

        qr_code = secrets.token_hex(6)
        expires = (datetime.now() + timedelta(minutes=duration)).isoformat()
        conn.execute("INSERT INTO attendance_sessions (course_id, teacher_id, qr_code, expires_at) VALUES (?,?,?,?)",
                     (course_id, user['id'], qr_code, expires))
        conn.commit()
        sid = conn.execute("SELECT last_insert_rowid()").fetchone()[0]
        conn.close()
        self.send_json({"id": sid, "qr_code": qr_code, "expires_at": expires})

    # ── Static Files ──
    def serve_static(self, path: str):
        file_path = os.path.join(os.path.dirname(os.path.abspath(__file__)), path.lstrip('/'))
        if not os.path.isfile(file_path):
            self.send_response(404)
            self.end_headers()
            return

        ext = os.path.splitext(file_path)[1]
        content_type = {'.css': 'text/css', '.js': 'application/javascript', '.png': 'image/png', '.ico': 'image/x-icon'}.get(ext, 'application/octet-stream')

        with open(file_path, 'rb') as f:
            data = f.read()
        self.send_response(200)
        self.send_header('Content-Type', content_type)
        self.send_header('Content-Length', len(data))
        self.end_headers()
        self.wfile.write(data)

    def log_message(self, format, *args):
        pass  # Suppress default logging


# ─────────────────────────────────────────────
# Main
# ─────────────────────────────────────────────
if __name__ == '__main__':
    init_db()
    server = HTTPServer(('0.0.0.0', PORT), Handler)
    print(f"🎓 CampusMind running at http://localhost:{PORT}")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nShutting down.")
        server.shutdown()
