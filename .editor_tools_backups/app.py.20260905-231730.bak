def page_dashboard(user: dict) -> str:
    conn = get_db()
    uid = user['id']
    role = user['role']

    stats_html = ""
    if role == 'student':
        enrolled = conn.execute("SELECT COUNT(*) as c FROM enrollments WHERE student_id=?", (uid,)).fetchone()['c']
        today = date.today().strftime('%A')
        today_classes = conn.execute("""
            SELECT COUNT(*) as c FROM routines r
            JOIN enrollments e ON e.course_id = r.course_id
            WHERE e.student_id=? AND r.day_of_week=?
        """, (uid, today)).fetchone()['c']
        unread = conn.execute("SELECT COUNT(*) as c FROM notifications WHERE user_id=? AND is_read=0", (uid,)).fetchone()['c']

        stats_html = f"""
        <div class="grid grid-4 mb-16">
            <div class="card stat-card"><div class="stat-value">{enrolled}</div><div class="stat-label">Enrolled Courses</div></div>
            <div class="card stat-card"><div class="stat-value">{today_classes}</div><div class="stat-label">Classes Today</div></div>
            <div class="card stat-card"><div class="stat-value">{unread}</div><div class="stat-label">Notifications</div></div>
        </div>"""

        # Today's schedule
        rows = conn.execute("""
            SELECT r.start_time, r.end_time, r.room, c.code, c.name
            FROM routines r JOIN courses c ON r.course_id = c.id
            JOIN enrollments e ON e.course_id = c.id
            WHERE e.student_id=? AND r.day_of_week=?
            ORDER BY r.start_time
        """, (uid, today)).fetchall()
        schedule_items = ""
        for r in rows:
            schedule_items += f"<tr><td>{r['start_time']} - {r['end_time']}</td><td>{r['code']}</td><td>{r['name']}</td><td>{r['room']}</td></tr>"
        schedule_html = f"""
        <div class="card">
            <div class="card-title">Today's Schedule ({today})</div>
            <div class="table-wrap">
                <table><thead><tr><th>Time</th><th>Code</th><th>Course</th><th>Room</th></tr></thead>
                <tbody>{schedule_items or '<tr><td colspan="4" class="text-muted text-center">No classes today</td></tr>'}</tbody></table>
            </div>
        </div>"""
        stats_html += schedule_html

    elif role in ('teacher', 'admin'):
        courses = conn.execute("SELECT COUNT(*) as c FROM courses WHERE teacher_id=?", (uid,)).fetchone()['c']
        students = conn.execute("SELECT COUNT(*) as c FROM users WHERE role='student'").fetchone()['c']
        stats_html = f"""
        <div class="grid grid-3 mb-16">
            <div class="card stat-card"><div class="stat-value">{courses}</div><div class="stat-label">My Courses</div></div>
            <div class="card stat-card"><div class="stat-value">{students}</div><div class="stat-label">Total Students</div></div>
        </div>
        <div class="card">
            <div class="card-title">Quick Actions</div>
            <div class="flex gap-8">
                <a href="/teacher" class="btn btn-primary">Teacher Panel</a>
                <a href="/courses" class="btn btn-secondary">Manage Courses</a>
            </div>
        </div>"""

    conn.close()
    return layout("Dashboard", f"""
    <div class="page-header">
        <h1>Dashboard</h1>
        <p>Welcome back, {user['name']}!</p>
    </div>
    {stats_html}
    """, user)


def page_courses(user: dict) -> str:
    conn = get_db()
    uid = user['id']
    role = user['role']

    if role == 'student':
        rows = conn.execute("""
            SELECT c.id, c.code, c.name, c.credits, c.department, c.semester, u.name as teacher
            FROM courses c
            JOIN enrollments e ON e.course_id = c.id
            LEFT JOIN users u ON c.teacher_id = u.id
            WHERE e.student_id=?
        """, (uid,)).fetchall()
    else:
        rows = conn.execute("""
            SELECT c.id, c.code, c.name, c.credits, c.department, c.semester, u.name as teacher
            FROM courses c LEFT JOIN users u ON c.teacher_id = u.id
        """).fetchall()

    items = ""
    for r in rows:
        items += f"""<tr>
            <td><strong>{r['code']}</strong></td>
            <td>{r['name']}</td>
            <td>{r['credits']}</td>
            <td>{r['teacher'] or '—'}</td>
            <td>{r['semester'] or '—'}</td>
        </tr>"""

    create_form = ""
    if role in ('teacher', 'admin'):
        create_form = f"""
        <div class="card mt-16">
            <div class="card-title">Add Course</div>
            <form method="POST" action="/courses/create">
                <div class="grid grid-3">
                    <div class="form-group"><label>Code</label><input name="code" required placeholder="CSE-301"></div>
                    <div class="form-group"><label>Name</label><input name="name" required placeholder="Data Structures"></div>
                    <div class="form-group"><label>Credits</label><input name="credits" type="number" value="3"></div>
                </div>
                <div class="grid grid-2">
                    <div class="form-group"><label>Department</label><input name="department" placeholder="CSE"></div>
                    <div class="form-group"><label>Semester</label><input name="semester" placeholder="Fall 2026"></div>
                </div>
                <button class="btn btn-primary">Add Course</button>
            </form>
        </div>"""

    enroll_form = ""
    if role == 'student':
        all_courses = conn.execute("SELECT id, code, name FROM courses").fetchall()
        opts = ''.join(f'<option value="{c["id"]}">{c["code"]} — {c["name"]}</option>' for c in all_courses)
        enroll_form = f"""
        <div class="card mt-16">
            <div class="card-title">Enroll in Course</div>
            <form method="POST" action="/courses/enroll">
                <div class="form-group"><select name="course_id">{opts}</select></div>
                <button class="btn btn-primary">Enroll</button>
            </form>
        </div>"""

    conn.close()
    return layout("Courses", f"""
    <div class="page-header"><h1>Courses</h1><p>{'My enrolled courses' if role == 'student' else 'All courses'}</p></div>
    <div class="card">
        <div class="table-wrap">
            <table><thead><tr><th>Code</th><th>Name</th><th>Credits</th><th>Teacher</th><th>Semester</th></tr></thead>
            <tbody>{items or '<tr><td colspan="5" class="text-muted text-center">No courses found</td></tr>'}</tbody></table>
        </div>
    </div>
    {create_form}
    {enroll_form}
    """, user)


def page_routine(user: dict) -> str:
    conn = get_db()
    uid = user['id']
    role = user['role']

    if role == 'student':
        rows = conn.execute("""
            SELECT r.id, r.day_of_week, r.start_time, r.end_time, r.room, c.code, c.name
            FROM routines r JOIN courses c ON r.course_id = c.id
            JOIN enrollments e ON e.course_id = c.id
            WHERE e.student_id=?
            ORDER BY CASE r.day_of_week
                WHEN 'Saturday' THEN 1 WHEN 'Sunday' THEN 2 WHEN 'Monday' THEN 3
                WHEN 'Tuesday' THEN 4 WHEN 'Wednesday' THEN 5 WHEN 'Thursday' THEN 6 ELSE 7 END,
                r.start_time
        """, (uid,)).fetchall()
    else:
        rows = conn.execute("""
            SELECT r.id, r.day_of_week, r.start_time, r.end_time, r.room, c.code, c.name
            FROM routines r JOIN courses c ON r.course_id = c.id
            ORDER BY CASE r.day_of_week
                WHEN 'Saturday' THEN 1 WHEN 'Sunday' THEN 2 WHEN 'Monday' THEN 3
                WHEN 'Tuesday' THEN 4 WHEN 'Wednesday' THEN 5 WHEN 'Thursday' THEN 6 ELSE 7 END,
                r.start_time
        """).fetchall()

    items = ""
    for r in rows:
        items += f"<tr><td>{r['day_of_week']}</td><td>{r['start_time']} - {r['end_time']}</td><td>{r['code']}</td><td>{r['name']}</td><td>{r['room']}</td></tr>"

    add_form = ""
    if role in ('teacher', 'admin'):
        courses = conn.execute("SELECT id, code, name FROM courses").fetchall()
        opts = ''.join(f'<option value="{c["id"]}">{c["code"]} — {c["name"]}</option>' for c in courses)
        days = ''.join(f'<option value="{d}">{d}</option>' for d in DAY_MAP.values())
        add_form = f"""
        <div class="card mt-16">
            <div class="card-title">Add Routine Entry</div>
            <form method="POST" action="/routine/create">
                <div class="grid grid-3">
                    <div class="form-group"><label>Course</label><select name="course_id">{opts}</select></div>
                    <div class="form-group"><label>Day</label><select name="day_of_week">{days}</select></div>
                    <div class="form-group"><label>Room</label><input name="room" required placeholder="301"></div>
                </div>
                <div class="grid grid-2">
                    <div class="form-group"><label>Start Time</label><input name="start_time" type="time" required></div>
                    <div class="form-group"><label>End Time</label><input name="end_time" type="time" required></div>
                </div>
                <button class="btn btn-primary">Add to Routine</button>
            </form>
        </div>"""

    conn.close()
    return layout("Routine", f"""
    <div class="page-header"><h1>Class Routine</h1><p>Weekly schedule</p></div>
    <div class="card">
        <div class="table-wrap">
            <table><thead><tr><th>Day</th><th>Time</th><th>Code</th><th>Course</th><th>Room</th></tr></thead>
            <tbody>{items or '<tr><td colspan="5" class="text-muted text-center">No routine entries</td></tr>'}</tbody></table>
        </div>
    </div>
    {add_form}
    """, user)


def page_attendance(user: dict) -> str:
    conn = get_db()
    uid = user['id']
    role = user['role']
    body = ""

    if role == 'student':
        # Show mark form + history
        records = conn.execute("""
            SELECT ar.status, ar.method, ar.marked_at, s.session_date, c.code
            FROM attendance_records ar
            JOIN attendance_sessions s ON ar.session_id = s.id
            JOIN courses c ON s.course_id = c.id
            WHERE ar.student_id=?
            ORDER BY ar.marked_at DESC LIMIT 20
        """, (uid,)).fetchall()

        rows_html = ""
        for r in records:
            status_badge = {'present': 'badge-green', 'late': 'badge-yellow', 'absent': 'badge-red'}.get(r['status'], 'badge-blue')
            rows_html += f"<tr><td>{r['session_date']}</td><td>{r['code']}</td><td><span class='badge {status_badge}'>{r['status']}</span></td><td>{r['method']}</td></tr>"

        body = f"""
        <div class="card mb-16">
            <div class="card-title">Mark Attendance</div>
            <form id="markForm">
                <div class="grid grid-2">
                    <div class="form-group"><label>Session ID</label><input id="sessionId" type="number" required placeholder="e.g. 1"></div>
                    <div class="form-group"><label>QR Code</label><input id="qrCode" required placeholder="Enter code"></div>
                </div>
                <button class="btn btn-primary">Mark Attendance</button>
            </form>
            <div id="markResult" class="mt-16"></div>
        </div>
        <div class="card">
            <div class="card-title">Attendance History</div>
            <div class="table-wrap">
                <table><thead><tr><th>Date</th><th>Course</th><th>Status</th><th>Method</th></tr></thead>
                <tbody>{rows_html or '<tr><td colspan="4" class="text-muted text-center">No records yet</td></tr>'}</tbody></table>
            </div>
        </div>"""

    else:
        # Teacher: create session + view sessions
        courses = conn.execute("SELECT id, code, name FROM courses WHERE teacher_id=?", (uid,)).fetchall()
        opts = ''.join(f'<option value="{c["id"]}">{c["code"]} — {c["name"]}</option>' for c in courses)
        sessions = conn.execute("""
            SELECT s.id, s.qr_code, s.session_date, s.is_active, s.expires_at, c.code
            FROM attendance_sessions s JOIN courses c ON s.course_id = c.id
            WHERE s.teacher_id=? ORDER BY s.created_at DESC LIMIT 10
        """, (uid,)).fetchall()

        sess_rows = ""
        for s in sessions:
            status = '<span class="badge badge-green">Active</span>' if s['is_active'] else '<span class="badge badge-red">Expired</span>'
            sess_rows += f"<tr><td>{s['id']}</td><td>{s['code']}</td><td class='font-mono'>{s['qr_code']}</td><td>{s['session_date']}</td><td>{status}</td></tr>"

        body = f"""
        <div class="card mb-16">
            <div class="card-title">Start Attendance Session</div>
            <form id="sessionForm">
                <div class="grid grid-2">
                    <div class="form-group"><label>Course</label><select id="sessionCourseId">{opts}</select></div>
                    <div class="form-group"><label>Duration (minutes)</label><input id="sessionDuration" type="number" value="10" min="1" max="60"></div>
                </div>
                <button class="btn btn-primary">Create Session</button>
            </form>
            <div id="sessionResult"></div>
        </div>
        <div class="card">
            <div class="card-title">Recent Sessions</div>
            <div class="table-wrap">
                <table><thead><tr><th>ID</th><th>Course</th><th>Code</th><th>Date</th><th>Status</th></tr></thead>
                <tbody>{sess_rows or '<tr><td colspan="5" class="text-muted text-center">No sessions yet</td></tr>'}</tbody></table>
            </div>
        </div>"""

    conn.close()
    return layout("Attendance", f"""
    <div class="page-header"><h1>Attendance</h1><p>{'Mark your attendance' if role == 'student' else 'Manage attendance sessions'}</p></div>
    {body}
    """, user)


def page_results(user: dict) -> str:
    conn = get_db()
    uid = user['id']
    role = user['role']

    if role == 'student':
        rows = conn.execute("""
            SELECT r.exam_type, r.marks_obtained, r.total_marks, r.grade, r.grade_point, c.code
            FROM results r JOIN courses c ON r.course_id = c.id
            WHERE r.student_id=? ORDER BY r.created_at DESC
        """, (uid,)).fetchall()

        items = ""
        for r in rows:
            items += f"<tr><td>{r['code']}</td><td>{r['exam_type']}</td><td>{r['marks_obtained']}/{r['total_marks']}</td><td><strong>{r['grade']}</strong></td><td>{r['grade_point']}</td></tr>"

        # CGPA
        all_gp = conn.execute("SELECT grade_point FROM results WHERE student_id=? AND grade_point IS NOT NULL", (uid,)).fetchall()
        cgpa = round(sum(r['grade_point'] for r in all_gp) / len(all_gp), 2) if all_gp else 0

        body = f"""
        <div class="grid grid-3 mb-16">
            <div class="card stat-card"><div class="stat-value">{cgpa}</div><div class="stat-label">CGPA</div></div>
            <div class="card stat-card"><div class="stat-value">{len(all_gp)}</div><div class="stat-label">Total Results</div></div>
        </div>
        <div class="card">
            <div class="card-title">My Results</div>
            <div class="table-wrap">
                <table><thead><tr><th>Course</th><th>Exam</th><th>Marks</th><th>Grade</th><th>GP</th></tr></thead>
                <tbody>{items or '<tr><td colspan="5" class="text-muted text-center">No results yet</td></tr>'}</tbody></table>
            </div>
        </div>"""
    else:
        body = """<div class="card"><p>Use the <a href="/teacher">Teacher Panel</a> to enter results.</p></div>"""

    conn.close()
    return layout("Results", f"""
    <div class="page-header"><h1>Results</h1></div>
    {body}
    """, user)


def page_teacher(user: dict) -> str:
    conn = get_db()
    uid = user['id']

    courses = conn.execute("SELECT id, code, name FROM courses WHERE teacher_id=?", (uid,)).fetchall()
    students = conn.execute("SELECT id, name, student_id FROM users WHERE role='student'").fetchall()

    course_opts = ''.join(f'<option value="{c["id"]}">{c["code"]} — {c["name"]}</option>' for c in courses)
    student_opts = ''.join(f'<option value="{s["id"]}">{s["name"]} ({s["student_id"] or s["id"]})</option>' for s in students)

    conn.close()
    return layout("Teacher Panel", f"""
    <div class="page-header"><h1>Teacher Panel</h1><p>Manage results and syllabus</p></div>
    <div class="grid grid-2">
        <div class="card">
            <div class="card-title">Enter Result</div>
            <form method="POST" action="/teacher/result">
                <div class="form-group"><label>Student</label><select name="student_id">{student_opts}</select></div>
                <div class="form-group"><label>Course</label><select name="course_id">{course_opts}</select></div>
                <div class="grid grid-2">
                    <div class="form-group"><label>Exam Type</label>
                        <select name="exam_type">
                            <option value="mid">Mid</option>
                            <option value="final">Final</option>
                            <option value="quiz">Quiz</option>
                            <option value="assignment">Assignment</option>
                        </select>
                    </div>
                    <div class="form-group"><label>Marks</label><input name="marks" type="number" step="0.5" required></div>
                </div>
                <div class="form-group"><label>Total Marks</label><input name="total" type="number" value="100"></div>
                <button class="btn btn-primary">Submit Result</button>
            </form>
        </div>
        <div class="card">
            <div class="card-title">Add Syllabus Topic</div>
            <form method="POST" action="/teacher/syllabus">
                <div class="form-group"><label>Course</label><select name="course_id">{course_opts}</select></div>
                <div class="form-group"><label>Topic Title</label><input name="title" required placeholder="Chapter 1: Introduction"></div>
                <div class="form-group"><label>Week Number</label><input name="week_number" type="number" placeholder="1"></div>
                <button class="btn btn-primary">Add Topic</button>
            </form>
        </div>
    </div>
    """, user)


def page_notifications(user: dict) -> str:
    conn = get_db()
    rows = conn.execute("SELECT id, title, message, is_read, created_at FROM notifications WHERE user_id=? ORDER BY created_at DESC", (user['id'],)).fetchall()
    conn.close()

    items = ""
    for r in rows:
        read_class = "" if r['is_read'] else "style='border-left: 3px solid var(--primary);'"
        btn = "" if r['is_read'] else f'<button class="btn btn-sm btn-secondary" data-notif-id="{r["id"]}">Mark Read</button>'
        items += f"""<div class="card" {read_class}>
            <div class="flex-between">
                <div><strong>{r['title']}</strong><p class="text-sm text-muted">{r['message']}</p></div>
                {btn}
            </div>
        </div>"""

    return layout("Notifications", f"""
    <div class="page-header"><h1>Notifications</h1></div>
    {items or '<div class="empty-state"><div class="icon">🔔</div><p>No notifications</p></div>'}
    """, user)


def page_assistant(user: dict) -> str:
    return layout("Assistant", f"""
